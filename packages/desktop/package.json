{
  "name": "@reineke/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Reineke-Protokoll Desktop-App (Electron)",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint electron src",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "de.reineke-technik.protokoll",
    "productName": "Reineke-Protokoll",
    "copyright": "© Reineke Technik",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/keytar/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**",
      "**/node_modules/node-addon-api/**",
      "**/node_modules/nodejs-whisper/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release/${version}"
    },
    "files": [
      "dist-electron/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/{.eslintrc.cjs,.prettierrc,tsconfig.json,vitest.config.ts}"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Reineke-Protokoll nimmt das Mikrofon auf, um Meetings zu transkribieren.",
        "NSCameraUsageDescription": "Wird nicht verwendet.",
        "NSAppleEventsUsageDescription": "Wird nicht verwendet."
      }
    },
    "dmg": {
      "title": "Reineke-Protokoll ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reineke-Protokoll"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  },
  "dependencies": {
    "@reineke/shared": "workspace:*",
    "better-sqlite3": "11.7.0",
    "keytar": "7.9.0",
    "nodejs-whisper": "0.2.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.0.2",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "zustand": "5.0.2"
  }
}
