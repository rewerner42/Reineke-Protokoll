{
  "expo": {
    "name": "Reineke-Protokoll",
    "slug": "reineke-protokoll",
    "version": "0.1.0",
    "scheme": "reineke",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-audio"],
    "ios": {
      "bundleIdentifier": "de.reineke.protokoll",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Reineke benötigt Zugriff auf das Mikrofon, um Meetings aufzuzeichnen und lokal zu transkribieren.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "de.reineke.protokoll",
      "permissions": ["RECORD_AUDIO", "INTERNET", "FOREGROUND_SERVICE"]
    },
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
